{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "^(www\\.)?reddyannasite\\.live(\\:\\d+)?$"
        }
      ],
      "destination": "/sitemap-reddyannasite.xml"
    },
    {
      "source": "/((?!.*\\.).*)$",
      "destination": "/index.html"
    }
  ]
}
